// Define the Prisma client generator, specifying the JavaScript client for database access.
generator client {
  provider = "prisma-client-js" // Generates the Prisma client for Node.js
  binaryTargets = ["native", "darwin-arm64"]
}

// Define the database connection with PostgreSQL as the provider.
datasource db {
  provider = "postgresql" // Specifies PostgreSQL as the database provider
  url      = env("DATABASE_URL") // Fetches the connection string from an environment variable
}

// Define all different role for users
enum UserRole {
  TEACHER
  ADMIN
  STUDENT
}

// The User model represents application users.
model User {
  id            Int           @id @default(autoincrement()) // Primary key, auto-incrementing integer
  name          String // Name of the user
  username      String // Gihub username
  email         String        @unique // Email address, must be unique
  githubId      String?       @unique // Optional GitHub ID, must be unique if provided
  accessToken   String? // Optional GitHub OAuth access token
  avatarUrl     String? // Optional URL to the user's avatar
  createdAt     DateTime      @default(now()) // Timestamp of when the user was created
  enrollments   Enrollment[] // Relationship to the Enrollment model, tracks user challenge enrollments, stay empty if user is TEACHER
  challenges    Challenge[] // Relationship to the Challenge model, tracks challenge created by a TEACHER, stay empty if user is STUDENT
  user_role     UserRole // Role of the user : Teacher, Admin, Student
}

// Session model respresents the user's session.
// Fields:
// - id: Unique identifier for each session (auto-incrementing integer).
// - sid: Session ID (string).
// - data: Session data (JSON).
// - expiresAt: Timestamp when the session expires (datetime).
model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
}

// The Challenge model represents coding challenges or courses.
model Challenge {
  id            Int          @id @default(autoincrement()) // Primary key, auto-incrementing integer
  authorId      Int // Id of the author
  author        User         @relation(fields: [authorId], references: [id]) // Relation explicite avec User
  title         String // Title of the challenge
  description   String // Detailed description of the challenge
  difficulty    String? // Optional difficulty level (e.g., Easy, Medium, Hard)
  estimatedTime Int? // Optional estimated time to complete in minutes
  prerequisites Int[] // Array of challenge IDs that are prerequisites for this challenge
  stages        Stage[] // Relationship to the Stage model, contains the stages of this challenge
  createdAt     DateTime     @default(now()) // Timestamp of when the challenge was created
  Enrollment    Enrollment[] // Relationship to the Enrollment model, tracks user enrollments for this challenge
}

// The Stage model represents individual stages or levels within a challenge.
model Stage {
  id          Int           @id @default(autoincrement()) // Primary key, auto-incrementing integer
  title       String // Title of the stage
  description String // Detailed description of the stage
  order       Int // Order of the stage within the challenge
  challengeId Int // Foreign key referencing the Challenge model
  challenge   Challenge     @relation(fields: [challengeId], references: [id]) // Relationship to the Challenge model

  @@unique([challengeId, order]) // Ensures that each stage order is unique within a challenge
}

// The Enrollment model tracks user enrollments in challenges and their progress.
model Enrollment {
  id            Int       @id @default(autoincrement())
  userId        Int
  challengeId   Int
  currentStage  Int       @default(0) // Tracks the user's current stage in the challenge
  repoUrl       String?   // URL to the user's repository for the challenge
  enrolledAt    DateTime  @default(now())
  finishedAt    DateTime?
  status        String    @default("in_progress") // Challenge status (e.g., in_progress, completed, failed)
  pushValidated Boolean   @default(false) // Indicates if the Git push is validated for the current stage
  testValidated Boolean   @default(false) // Indicates if the stage test is validated
  user          User      @relation(fields: [userId], references: [id])
  challenge     Challenge @relation(fields: [challengeId], references: [id])
}

