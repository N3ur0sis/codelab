{
  "name": "codelab-backend",
  "version": "0.3.0",
  "description": "Backend service for the CodeLab learning management system.",
  "main": "src/index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --watch src --ext js,json --exec node src/index.js",
    "prisma:studio": "npx prisma studio",
    "format": "prettier --write \"**/*.{js,ts,html,css,md,json}\"",
    "lint": "eslint . ",
    "lint:fix": "eslint . --fix ",
    "seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "backend",
    "codelab",
    "lms",
    "express",
    "prisma"
  ],
  "author": "Aymeric ROBERT",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^21.0.2",
    "@prisma/client": "^4.0.0",
    "@quixo3/prisma-session-store": "^3.1.13",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.13.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2"
  }
}
