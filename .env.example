# Backend variables
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>?schema=<schema>
POSTGRES_USER=<your_postgres_user>
POSTGRES_PASSWORD=<your_postgres_password>
POSTGRES_DB=<your_postgres_db>

#Github Challenge App
GITHUB_APP_ID=<your-github-app-id>
GITHUB_APP_PRIVATE_KEY=<your-private-key-content>
GITHUB_APP_CLIENT_ID=<your-github-client-id>
GITHUB_APP_CLIENT_SECRET=<your-github-client-secret>
GITHUB_ORG=<your-github-organization>
GITHUB_WEBHOOK_SECRET=<your-webhook-secret>

# Frontend variables
NEXT_PUBLIC_API_URL=<your_api_url>

